# Copie para .env e preencha. Nao commitar o .env.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5.6-luna

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

HELENA_BASE_URL=https://api.helena.run
HELENA_WTS_BASE_URL=https://api.wts.chat

HELENA_PROD_MESSAGE_TOKEN=
HELENA_PROD_TAG_TOKEN=
HELENA_PROD_FILE_TOKEN=
HELENA_PROD_PANEL_ID=
HELENA_PROD_STEP_ID_NOVO_LEAD=
HELENA_PROD_STEP_ID_EM_ATENDIMENTO=
HELENA_PROD_DEPARTMENT_ID=

HELENA_TEST_MESSAGE_TOKEN=
HELENA_TEST_TAG_TOKEN=
HELENA_TEST_FILE_TOKEN=
HELENA_TEST_PANEL_ID=
HELENA_TEST_STEP_ID_NOVO_LEAD=
HELENA_TEST_STEP_ID_EM_ATENDIMENTO=
HELENA_TEST_DEPARTMENT_ID=

DATABASE_URL=postgresql+asyncpg://agente_bistro:changeme@postgres:5432/agente_bistro
REDIS_URL=redis://redis:6379/0
DEBOUNCE_SECONDS=2

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
POSTGRES_PASSWORD=changeme

# Google Calendar (reservas automaticas) - conta de servico dedicada, agenda compartilhada
# com o e-mail dela. GOOGLE_CREDENTIALS_PATH aponta pra chave JSON baixada do Google Cloud
# Console; o arquivo deve ficar em credenciais/ (pasta no .gitignore, nunca commitar).
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_PATH=credenciais/service-account.json
MAX_CAPACITY_PER_SLOT=10

# --- Observabilidade (Langfuse) ---------------------------------------------------------
# Sem as duas chaves fica desligado (nada sai do processo). Use Langfuse self-hosted: o trace
# leva a fala do cliente. PUBLIC_URL: o endereco que o navegador abre, quando difere do que a
# API usa (ex.: host.docker.internal).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_URL=
# Versao do codigo no ar, enviada como tag "release:<versao>" nos traces.
APP_VERSION=dev

# Falhas provocadas de proposito, SO no ambiente "teste" (ignorada em producao):
# llm,envio,transferencia,audio,foto
SIMULAR_FALHA=

# --- Testes (DeepEval) - so para quem roda `deepeval test run tests/` -------------------
# Juiz LLM das conversas (tests/test_conversas.py). Sem chave do provedor do juiz, so a
# metrica deterministica roda.
DEEPEVAL_JUDGE_MODEL=gpt-5.4-mini
DEEPEVAL_TELEMETRY_OPT_OUT=1
